flowchart TB
  Agent["<b>Agent workload</b><br/>No provider credentials"]
  Network["<b>Network sandbox</b><br/>Allow / deny + intercept"]
  Proxy["<b>Egress Proxy</b><br/>Trusted sender<br/>Inject + protect responses"]
  Network -. "permitted traffic" .-> Proxy
  OCC["<b>OCC authorization</b><br/>1. Before material access<br/>2. Final check before send"]
  Provider["<b>Provider</b><br/>GitHub / inference"]
  Resolver["<b>Credential Resolver</b><br/>Pure lookup<br/>Static / warm dynamic"]
  Agent -.-> Network
  Proxy -. "checks 1 and 2" .-> OCC
  Proxy -. "authorized send" .-> Provider
  Proxy -. "resolve if needed<br/>between checks" .-> Resolver
  class Agent,Provider external
  class Proxy action
  class Network gate
  class OCC,Resolver api
  classDef api fill:#EDF2F7,stroke:#879AB0,color:#25364A,stroke-width:1px
  classDef action fill:#EBF3F0,stroke:#7F9D93,color:#2B4038,stroke-width:1px
  classDef external fill:#F2EDF6,stroke:#A394AF,color:#40354B,stroke-width:1px
  classDef gate fill:#F7F1E5,stroke:#B3A078,color:#514532,stroke-width:1px
  linkStyle default stroke:#748798,stroke-width:1px
