flowchart TB
  Agent["<b>Agent workload</b><br/>No provider material"]
  Proxy["<b>Agent egress proxy</b><br/>Concrete enforcement"]
  Other["<b>Bootstrap / discovery</b><br/>Separate trusted callers"]
  Sender["<b>Trusted sender</b><br/>Logical role<br/>Capture, inject, protect"]
  OCC["<b>OCC</b><br/>Current authorization"]
  Resolver["<b>CredentialResolver</b><br/>Static or warm dynamic"]
  Provider["<b>Provider</b><br/>GitHub or inference"]
  Background["<b>Lifecycle owner</b><br/>Schedules provider issuer<br/>Background preparation"]
  Agent -. mediated egress .-> Proxy
  Proxy -. fulfills role .-> Sender
  Other -. use sender role .-> Sender
  Sender -. authorized send .-> Provider
  Sender -. two online checks .-> OCC
  Sender -. resolve if needed .-> Resolver
  Background -. prepare warm material .-> Resolver
  class Agent,Other,Provider external
  class Proxy action
  class Sender logical
  class OCC,Resolver api
  class Background action
