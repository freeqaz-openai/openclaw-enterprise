flowchart TB
  Setup["<b>Operator</b><br/>Declare sources and bindings"]
  Control["<b>OCC</b><br/>Admit config, check policy"]
  Store["<b>Secret store</b><br/>Static and refresh inputs"]
  Static["<b>Secret Driver</b><br/>Read current values"]
  Dynamic["<b>Token Service</b><br/>Warm tokens in background"]
  Agent["<b>Agent or bootstrap</b><br/>Egress with identity"]
  Gateway["<b>Egress Proxy</b><br/>Authorize, inject, send"]
  Resolver["<b>Credential resolver</b><br/>Route binding, resolve use"]
  Provider["<b>Provider</b><br/>GitHub, inference"]
  Setup -. declarations .-> Control
  Control -. prepare grants .-> Dynamic
  Agent -. request .-> Gateway
  Gateway -. final check .-> Control
  Gateway -. resolve binding .-> Resolver
  Resolver -. check current use .-> Control
  Resolver -. static .-> Static
  Resolver -. warm dynamic .-> Dynamic
  Static -. read .-> Store
  Dynamic -. refresh inputs .-> Static
  Gateway -. inject and forward .-> Provider
  class Setup,Agent,Provider external
  class Store external
  class Gateway action
  class Control,Resolver,Static,Dynamic api
