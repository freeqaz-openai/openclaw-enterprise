config:
  theme: base
  htmlLabels: true
  themeVariables:
    fontFamily: "Arial, sans-serif"
    fontSize: "16px"
    primaryTextColor: "#25364A"
    lineColor: "#748798"
    edgeLabelBackground: "#FFFFFF"
  flowchart:
    useMaxWidth: false
    curve: linear
    nodeSpacing: 16
