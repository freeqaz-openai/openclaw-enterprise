---
flowchart TB
  Repo{"Repository<br/>configured?"}
  Bootstrap["<b>Trusted bootstrap</b><br/>Scoped authorized clone"]
  Gate["<b>Sender check</b><br/>Warm token and<br/>final OCC decision"]
  Clone["<b>Trusted sender → GitHub</b><br/>Inject token, forward clone"]
  Start["<b>Compute starts Agent</b><br/>Required gates satisfied"]
  Block["<b>Compute / bootstrap</b><br/>Block startup by default<br/>Own partial work"]
  Repo -.->|no clone| Start
  Repo -.->|yes| Bootstrap
  Bootstrap -.-> Gate
  Gate -.->|allow + usable| Clone
  Gate -.->|not allowed / not usable| Block
  Clone -.->|observed success| Start
  Clone -.->|failed / uncertain| Block
  class Bootstrap,Clone,Start action
  class Gate api
  class Repo,Block gate
  classDef api fill:#EDF2F7,stroke:#879AB0,color:#25364A,stroke-width:1px
  classDef action fill:#EBF3F0,stroke:#7F9D93,color:#2B4038,stroke-width:1px
  classDef gate fill:#F7F1E5,stroke:#B3A078,color:#514532,stroke-width:1px
  linkStyle default stroke:#748798,stroke-width:1px
